# Example Environment Configuration
# Copy this to .env.local and update with your values

# PostgreSQL Database
DB_NAME=kindura_db
DB_USER=kindura_user
DB_PASSWORD=kindura_pass
DB_HOST=localhost
DB_PORT=5432

# Local Development Authentication Token
# This will be auto-generated when you run ./setup_local.sh
LOCAL_DEV_TOKEN=your_token_here

# API Configuration
API_BASE_URL=http://127.0.0.1:8000/api
